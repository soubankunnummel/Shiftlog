# Filled in automatically by `npx convex dev` the first time you run it.
NEXT_PUBLIC_CONVEX_URL

# From `npm run generate:vapid` — only the PUBLIC key goes here.
# The private key goes into Convex's own env vars instead (see README), never here.

NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Auth is Convex-side only — nothing secret goes in this file.
# Set these with `npx convex env set` (see README):
#   AUTH_ADMIN_EMAIL, AUTH_ADMIN_PASSWORD
# The `npx @convex-dev/auth` initializer configures SITE_URL / JWT_PRIVATE_KEY / JWKS for you.